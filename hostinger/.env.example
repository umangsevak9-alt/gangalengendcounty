# Copy to `.env` on the server. NEVER commit real values.

APP_URL=https://yourdomain.com
APP_ENV=production

# --- Database (from Hostinger hPanel -> Databases -> MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456_novaone
DB_USER=u123456_admin
DB_PASS=

# --- Auth ---
# Generate a strong 64-char random string, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL_DAYS=7

# --- SMTP for password reset emails ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME=Ganga Legend County

# --- Uploads ---
UPLOAD_MAX_MB=25
